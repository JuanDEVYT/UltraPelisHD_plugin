{
  "id": "ultrapelishd",
  "name": "UltraPelisHD",
  "version": "2.0.0",
  "apiVersion": 20,
  "debug": true,
  "entry": "plugin.js",
  "description": "Películas, series, anime y doramas de UltraPelisHD con sus copias por idioma (Latino, Castellano, Subtitulado, Inglés), sus servidores, fichas completas, panel en el reproductor y pantalla propia.",
  "author": "JuanDEVYT",
  "homepage": "https://github.com/JuanDEVYT/UltraPelisHD_plugin",
  "hosts": [
    "ultrapelishd.com",
    "api-encrypted.moviemaster.lat"
  ],
  "streamHosts": "any",
  "fetchHosts": "any",
  "browser": "pages",
  "capabilities": [
    "search",
    "home",
    "browse",
    "episodes",
    "resolve",
    "download",
    "screen",
    "catalog",
    "schedule",
    "storageLarge"
  ],
  "jobs": [
    {
      "id": "refresh",
      "label": {
        "es": "Actualizar catálogo",
        "en": "Refresh catalog"
      },
      "everyMin": 360,
      "everyOptions": [
        180,
        360,
        720,
        1440
      ]
    }
  ],
  "categories": [
    "movies",
    "series",
    "anime"
  ],
  "section": {
    "label": "UltraPelisHD",
    "labelEn": "UltraPelisHD"
  },
  "theme": {
    "accent": "#54B9C5",
    "onAccent": "#06181A",
    "background": "#141414",
    "surface": "#1F1F1F",
    "highlight": "#F5C518"
  },
  "color": "#E50914",
  "icon": "icon.png",
  "panel": {
    "label": "UltraPelisHD",
    "labelEn": "UltraPelisHD",
    "icon": "movie"
  },
  "settings": [
    {
      "key": "datos",
      "label": "Preferencias",
      "labelEn": "Preferences",
      "type": "section",
      "hint": "Elige con qué copia abre Kino cada título. Todas las copias quedan siempre en el menú Servidor del reproductor.",
      "hintEn": "Choose which copy Kino starts with. Every copy always stays in the player's Server menu."
    },
    {
      "key": "lang",
      "label": "Idioma preferido",
      "labelEn": "Preferred language",
      "type": "select",
      "default": "auto",
      "hint": "Solo cambia cuál va primero",
      "hintEn": "Only changes which one comes first",
      "options": [
        {
          "value": "auto",
          "label": "Automático (el que mejor reproduzca)",
          "labelEn": "Automatic (best playing)"
        },
        {
          "value": "LAT",
          "label": "🇲🇽 Latino",
          "labelEn": "🇲🇽 Latin Spanish"
        },
        {
          "value": "ESP",
          "label": "🇪🇸 Castellano",
          "labelEn": "🇪🇸 Castilian Spanish"
        },
        {
          "value": "SUB",
          "label": "🇬🇧 Subtitulado",
          "labelEn": "🇬🇧 Subtitled"
        },
        {
          "value": "ENG",
          "label": "🇺🇸 Inglés",
          "labelEn": "🇺🇸 English"
        }
      ]
    },
    {
      "key": "estado",
      "label": "Conexión con UltraPelisHD",
      "labelEn": "Connection to UltraPelisHD",
      "type": "status"
    },
    {
      "key": "probar",
      "label": "Probar conexión",
      "labelEn": "Test connection",
      "type": "action"
    },
    {
      "key": "indice",
      "label": "Índice de películas",
      "labelEn": "Movie index",
      "type": "status"
    },
    {
      "key": "actualizarIndice",
      "label": "Descargar o actualizar el catálogo",
      "labelEn": "Download or refresh the catalog",
      "type": "action"
    },
    {
      "key": "ultimo",
      "label": "Últimas lecturas",
      "labelEn": "Last reads",
      "type": "status"
    },
    {
      "key": "servidores",
      "label": "Servidores y copias",
      "labelEn": "Servers and copies",
      "type": "section",
      "hint": "El plugin usa los servidores de UltraPelisHD y los entrega como copias del menú Servidor, cada una con la bandera de su idioma. Las versiones Subtitulado son las que traen los subtítulos quemados del sitio.",
      "hintEn": "The plugin uses UltraPelisHD's servers and hands them to Kino as copies in the Server menu, each with its language flag. The Subtitled ones carry the site's burned-in subtitles."
    }
  ],
  "settingsLayout": [
    {
      "type": "card",
      "title": "Idioma",
      "titleEn": "Language",
      "children": [
        {
          "setting": "datos"
        },
        {
          "setting": "lang"
        }
      ]
    },
    {
      "type": "card",
      "title": "Conexión",
      "titleEn": "Connection",
      "children": [
        {
          "type": "row",
          "children": [
            {
              "setting": "estado"
            },
            {
              "setting": "probar"
            }
          ]
        },
        {
          "setting": "ultimo"
        },
        {
          "setting": "indice"
        },
        {
          "setting": "actualizarIndice"
        }
      ]
    },
    {
      "setting": "servidores"
    }
  ],
  "screen": {
    "label": "UltraPelisHD",
    "labelEn": "UltraPelisHD",
    "icon": "movie",
    "menuOpens": "screen",
    "opensFrom": [
      "menu",
      "settings"
    ],
    "settingsButton": {
      "label": "Abrir UltraPelisHD",
      "labelEn": "Open UltraPelisHD"
    }
  },
  "signature": {
    "authorKey": "0036d8031405ef39f52a4c120617f46a8db166fa23867367f7ae68360f7e31cd",
    "value": "994aaf31e1b477341f0b73ddf9acd1596ef1fa4dad6dda3b09192126e4975833b6db11a855a3c64a3e48eed70663be83f9924f71ccbc6d81d8ba6bb53ccc5f02"
  }
}
